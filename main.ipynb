   "source": [
    "class basisStates:\n",
    "    def __init__(self, L):\n",
    "        self.L = L\n",
    "        self.dim = 2**L\n",
    "\n",
    "    def getBitstring(self, index):\n",
    "        return format(index, f\"0{self.L}b\")\n",
    "\n",
    "    def getIndex(self, bitstr):\n",
    "        return int(bitstr, 2)"
   ]
